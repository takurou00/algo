# ============================================
# Application
# ============================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================
# Database (Azure PostgreSQL Flexible Server)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/mediavault

# ============================================
# Azure Storage
# ============================================
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_STORAGE_CONTAINER_NAME=mediavault

# ============================================
# Azure (Terraform / CI/CD)
# ============================================
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# ============================================
# Auth (Better Auth)
# ============================================
BETTER_AUTH_SECRET=your_super_secret_key_min_32_chars
BETTER_AUTH_URL=http://localhost:8000

# ============================================
# Redis (Azure Cache for Redis)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Email (SMTP) - Production: Azure Communication Services / SendGrid
# ============================================
# Leave empty in development (emails logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediaVault <noreply@mediavault.example.com>
